"""vdlu-pack - build a VDLU content-addressed manifest + blob store from a module tree.

Usage:
  vdlu-pack <module_tree_dir> <out_dir> <module_id> <version> \
            [--version-name X] [--channel stable] [--prev manifest.json]

Produces <out_dir>/manifest.json (canonical, UNSIGNED) and <out_dir>/blobs/<sha256>[.gz].
The manifest carries empty "key_id" and "sig" placeholders; run vdlu-sign afterwards.
Determinism: files are sorted by path; set SOURCE_DATE_EPOCH for a reproducible `built`.
See INTERFACES.md §3 and producer/README.md.
"""
import argparse
import datetime
import hashlib
import json
import os
import shutil
import subprocess
import sys

GZ_MIN_SIZE = 4096       # below this, HTTP gzip-on-the-wire already covers it
GZ_MIN_GAIN = 0.90       # keep the gz blob only when it saves >= 10%

SOFT_NAMES = {"service.sh", "post-fs-data.sh", "boot-completed.sh"}


def log(msg):
    sys.stderr.write("vdlu-pack: " + msg + "\n")


def classify(relpath):
    """Reboot-need class from path (INTERFACES.md §3). Never downgrades reboot->live."""
    parts = relpath.split("/")
    base = parts[-1]
    if relpath.startswith("system/"):
        return "reboot"
    if parts[0] == "zygisk" and base.endswith(".so"):
        return "reboot"
    if base.endswith(".rule"):
        return "reboot"
    if base in SOFT_NAMES and len(parts) == 1:
        return "soft"
    return "live"


def have_gzip():
    return shutil.which("gzip") is not None


def gzip_compress(raw):
    # -n: no name/timestamp in the gzip header -> deterministic, reproducible blob bytes.
    p = subprocess.run(["gzip", "-9", "-n", "-c"], input=raw,
                       stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    if p.returncode != 0:
        return None
    return p.stdout


def decide_blob(raw, gzip_ok):
    """Return (enc, blob_bytes, blob_suffix). sha256 is always of the ORIGINAL content."""
    if gzip_ok and len(raw) >= GZ_MIN_SIZE:
        comp = gzip_compress(raw)
        if comp is not None and len(comp) <= len(raw) * GZ_MIN_GAIN:
            return "gz", comp, ".gz"
    return "raw", raw, ""


def iso_built():
    sde = os.environ.get("SOURCE_DATE_EPOCH")
    if sde:
        dt = datetime.datetime.fromtimestamp(int(sde), datetime.timezone.utc)
    else:
        dt = datetime.datetime.now(datetime.timezone.utc)
    return dt.strftime("%Y-%m-%dT%H:%M:%SZ")


def exclusion_reason(rel):
    """Log reason if rel must NOT be packed into the feed, else None.

    Single source of truth for the raw-path exclusion predicate: walk_files uses
    it to drop files, and the --prev delete[] computation runs prev paths through
    it so an already-excluded path never leaks back as a spurious delete entry.
    """
    # baseline.json IS a copy of the signed manifest (the from:0 seed); including it in the
    # manifest is a self-reference regress (manifest -> baseline -> manifest). Never pack it.
    if rel == "vdlu/baseline.json" or rel == "baseline.json":
        return "skip baseline.json (install seed, not a fetchable blob)"
    # Per-file .sha256 companions belong only in the flashable zip, never in the
    # feed: packing them doubles the manifest and they go stale after an incremental update. This
    # lets committed-binary modules track them and CI-built modules keep them gitignored, either way.
    if rel.endswith(".sha256"):
        return "skip .sha256 companion (flashable-zip only, not VDLU content): " + rel
    # Installer scaffolding: ksud consumes META-INF/* and customize.sh at FLASH and does not keep
    # them in the installed module, and they ship in the full .zip, never via VDLU. Listing them
    # serves useless blobs, and if one ever changes between versions it would be "pending" and get
    # written as an installer file into the LIVE module dir. They are not VDLU content.
    if rel.startswith("META-INF/") or rel == "customize.sh" or rel.startswith(".vd/"):
        return "skip installer/flash scaffolding (ships in the .zip, not via VDLU): " + rel
    # update.json / update-mmrl.json get their size/sha filled by CI AFTER the zips and baseline
    # are built, so the shipped copy differs from the feed copy -> a phantom single-file fetch on
    # every install's first self-update. On device they are vestigial (the manager reads the remote
    # raw updateJson). Not VDLU content.
    if rel in ("update.json", "update-mmrl.json"):
        return "skip CI-filled update manifest (differs from feed, vestigial on device): " + rel
    # Dev / release docs and repo files are never on the installed device (the build strips them;
    # some are gitignored). Listing them serves useless blobs AND makes a doc edit churn the signed
    # canon on every release. Not VDLU content.
    if os.path.basename(rel) in ("RELEASE.md", "CLAUDE.md", ".gitignore"):
        return "skip dev/doc file (not shipped to device): " + rel
    # Vendored TRUST ROOT: keyring/ (RAW 32B trust-anchor pubkeys) and verify/ (ed25519-mini
    # verifier binaries) are flash-only by design - the keyring is stable / verify-not-copy. Shipping
    # them over the feed would let a manifest overwrite the on-device trust anchor in the trusted
    # profile. NEVER feed-deliverable.
    if rel.startswith("vdlu/keyring/") or rel.startswith("keyring/") or \
       rel.startswith("vdlu/verify/") or rel.startswith("verify/"):
        return "skip vendored trust root (keyring/verify are flash-only, never feed-deliverable): " + rel
    return None


def walk_files(tree):
    """Yield (relpath, abspath) for regular files only, sorted, never leaving the tree."""
    out = []
    for dp, dirs, files in os.walk(tree, followlinks=False):
        dirs.sort()
        for name in files:
            ap = os.path.join(dp, name)
            rel = os.path.relpath(ap, tree).replace(os.sep, "/")
            reason = exclusion_reason(rel)
            if reason is not None:
                log(reason)
                continue
            if os.path.islink(ap):
                log("skip symlink (not followed, no manifest type): " + rel)
                continue
            st = os.lstat(ap)
            if not (st.st_mode & 0o170000) == 0o100000:  # S_ISREG
                log("skip non-regular file: " + rel)
                continue
            out.append((rel.replace(os.sep, "/"), ap))
    out.sort(key=lambda x: x[0])
    return out


def main():
    ap = argparse.ArgumentParser(prog="vdlu-pack", add_help=True)
    ap.add_argument("module_tree_dir")
    ap.add_argument("out_dir")
    ap.add_argument("module_id")
    ap.add_argument("version", type=int)
    ap.add_argument("--version-name", default=None)
    ap.add_argument("--channel", default="stable")
    ap.add_argument("--prev", default=None, help="previous manifest.json to compute delete[]")
    ap.add_argument("--engine-min", type=int, default=3)
    ap.add_argument("--raw", action="store_true",
                    help="store every blob raw (no gzip). For a feed whose files are served raw at a fixed "
                         "path instead of blobs/<sha>.gz - e.g. a feed fetched whole in a single one-time "
                         "download, where decompressing each blob is not worth it. Keeps enc=raw consistent "
                         "with what is served.")
    a = ap.parse_args()

    tree = os.path.realpath(a.module_tree_dir)
    if not os.path.isdir(tree):
        log("not a directory: " + a.module_tree_dir)
        return 2

    out = a.out_dir
    blobs_dir = os.path.join(out, "blobs")
    os.makedirs(blobs_dir, exist_ok=True)

    gzip_ok = have_gzip() and not a.raw
    if not gzip_ok:
        log("gzip not found - all blobs stored raw")

    files_meta = []
    for rel, ap in walk_files(tree):
        with open(ap, "rb") as fh:
            raw = fh.read()
        sha = hashlib.sha256(raw).hexdigest()
        mode = format(os.lstat(ap).st_mode & 0o7777, "04o")
        enc, blob_bytes, suffix = decide_blob(raw, gzip_ok)
        blob_path = os.path.join(blobs_dir, sha + suffix)
        if not os.path.exists(blob_path):          # dedup: content-addressed, write once
            tmp = blob_path + ".tmp"
            with open(tmp, "wb") as bf:
                bf.write(blob_bytes)
            os.replace(tmp, blob_path)
        files_meta.append({
            "path": rel, "sha256": sha, "size": len(raw),
            "mode": mode, "enc": enc, "class": classify(rel),
        })

    deleted = []
    if a.prev:
        with open(a.prev, "r", encoding="utf-8") as pf:
            prev = json.load(pf)
        now_paths = {f["path"] for f in files_meta}
        # Run every prev path through the SAME exclusion predicate walk_files uses: a --prev that
        # points at a pre-exclusion manifest still lists now-excluded paths (baseline.json, META-INF/*,
        # keyring/, verify/, ...), and emitting them as delete[] would order the device to remove files
        # that were never feed content. An excluded path is simply not ours to delete.
        deleted = sorted(f["path"] for f in prev.get("files", [])
                         if f["path"] not in now_paths
                         and exclusion_reason(f["path"]) is None)

    manifest = {
        "schema": 1,
        "module": a.module_id,
        "version": a.version,
        "version_name": a.version_name if a.version_name is not None else "v%d" % a.version,
        "built": iso_built(),
        "engine_min": a.engine_min,
        "key_id": "",
        "channel": a.channel,
        "files": files_meta,
        "delete": deleted,
        "sig": "",
    }

    # Canonical store form: compact, sorted keys, UTF-8 (the exact bytes vdlu-sign hashes
    # after stripping "sig"). See producer/README.md.
    text = json.dumps(manifest, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    mpath = os.path.join(out, "manifest.json")
    tmp = mpath + ".tmp"
    with open(tmp, "w", encoding="utf-8") as mf:
        mf.write(text + "\n")
    os.replace(tmp, mpath)

    log("%d files, %d blob(s), %d delete(s) -> %s" %
        (len(files_meta), len(set(f['sha256'] for f in files_meta)), len(deleted), mpath))
    log("UNSIGNED - run: vdlu-sign %s <privkey.pem> <key_id>" % mpath)
    return 0


if __name__ == "__main__":
    sys.exit(main())
